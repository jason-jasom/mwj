# Import necessary modules
Import-Module DiskManagement

# Function to check disk usage
function Get-DiskUsage {
    param (
        [string]$DriveLetter = "C:"
    )

    $disk = Get-Disk -FriendlyName $DriveLetter
    $partition = Get-Partition -Disk $disk -Index 1
    $status = Get-DiskHealth -Disk $disk | Select-Object -ExpandProperty Status

    $usage = Get-Disk -FriendlyName $DriveLetter | Select-Object -ExpandProperty Usage
    $totalSize = $usage.TotalSize
    $usedSize = $usage.UsedSize
    $freeSize = $usage.FreeSpace

    return @{
        DriveLetter = $DriveLetter
        TotalSize = $totalSize
        UsedSize = $usedSize
        FreeSize = $freeSize
        Status = $status
    }
}

